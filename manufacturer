<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="claude:viewport-fit-sides" content="cover">
  <title>Manufacturer Dashboard · PharmaTrace</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="css/style.css" rel="stylesheet">
</head>
<body>
  <header id="nav"></header>
  <main class="pt-wrap">
    <div class="pt-head">
      <div>
        <p class="pt-eyebrow">Manufacturer</p>
        <h1 id="pageTitle">My batches</h1>
        <p>Register each batch when it is made, dispatch it with a driver, and recall it if a problem is found.</p>
      </div>
      <button class="btn btn-primary" type="button" id="registerBtn">+ Register new batch</button>
    </div>

    <section class="pt-stats" id="stats" aria-label="Summary"></section>

    <section class="pt-panel" aria-labelledby="tableTitle">
      <div class="pt-panel__head">
        <h2 id="tableTitle">Batches</h2>
        <div class="pt-toolbar">
          <label class="visually-hidden" for="search">Search batches</label>
          <input class="form-control form-control-sm" id="search" type="search" placeholder="Search ID or drug">
          <label class="visually-hidden" for="filter">Filter by status</label>
          <select class="form-select form-select-sm" id="filter">
            <option value="all">All statuses</option>
            <option value="Genuine">Genuine</option>
            <option value="Under Review">Under Review</option>
            <option value="Recalled">Recalled</option>
            <option value="Counterfeit">Counterfeit</option>
            <option value="expiring">Expiring in 30 days</option>
          </select>
          <button class="btn btn-sm btn-outline-secondary" type="button" id="csvBtn">Export CSV</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table pt-table table-hover">
          <thead><tr><th>Batch ID</th><th>Drug</th><th>Qty</th><th>Expiry</th><th>Where now</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="js/ledger.js"></script>
  <script src="js/data.js"></script>
  <script src="js/ui.js"></script>
  <script src="js/auth.js"></script>
  <script src="js/actions.js"></script>
  <script src="js/manufacturer.js"></script>
</body>
</html>
